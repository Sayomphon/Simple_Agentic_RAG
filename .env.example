OPENAI_API_KEY=
MODEL_NAME=gpt-5-mini
TEMPERATURE=0
KB_PATH=knowledge_base.txt

# Optional per-role model overrides; leave commented to use MODEL_NAME
# for both agents.
# RETRIEVER_MODEL_NAME=gpt-5-mini
# REPORTER_MODEL_NAME=gpt-5-mini

# Optional LLM client hardening (seconds / retry attempts).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Opt-in only; leave disabled for normal local/unit-test execution.
RUN_LIVE_LLM_TESTS=0
LIVE_LLM_TEST_MODEL=gpt-5-mini
